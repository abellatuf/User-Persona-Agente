{
  "name": "user-persona-agente",
  "version": "0.1.0",
  "description": "Agente de IA para construir User Personas basadas en evidencia, conectado a Notion por MCP.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "probar-modelos": "node dist/probar-modelos.js",
    "evals": "node dist/evals/correr.js",
    "aceptacion": "node dist/evals/aceptacion.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@notionhq/notion-mcp-server": "2.5.2",
    "unpdf": "1.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
